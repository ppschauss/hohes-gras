# Kopie nach secrets.env anlegen und ausfüllen (secrets.env ist gitignored, chmod 600).

# Von @BotFather. Pflicht.
BOT_TOKEN=123456789:AA...

# Signiert die Session-Tokens. Mindestens 32 Zeichen, zufällig.
# Erzeugen mit:  head -c 48 /dev/urandom | base64 | tr -d '\n/+=' | head -c 64
SESSION_SECRET=

# Deine numerische Telegram-User-ID. Dieser Account wird Admin und braucht
# keinen Einladungscode. Leer lassen ist erlaubt: dann wird der allererste
# Trainer automatisch Admin.
ADMIN_TELEGRAM_ID=

# Öffentliche HTTPS-Adresse der Mini-App. Telegram akzeptiert nur HTTPS.
PUBLIC_URL=https://poke.otakupulse.de

PORT=3010
DATA_DIR=/data
CONTENT_PACK=kanto

# --- Verbund (optional) -------------------------------------------------
# Verbindet diese Instanz mit der globalen Spielerbasis: gemeinsame Rangliste,
# später Freunde, Chat und Handel über Instanzgrenzen. Alle drei leer lassen
# heißt: kein Verbund, und die Instanz verhält sich exakt wie ohne.
# Angemeldet wird eine Instanz einmalig beim Verbund-Dienst; er gibt das
# Geheimnis genau einmal heraus. Siehe docs/VERBUND.md.
HUB_URL=
HUB_INSTANCE_ID=
HUB_SECRET=
# Alternative zu HUB_SECRET fuer eine neue Installation: mit dem
# Beitrittsschluessel meldet sich die Instanz beim ersten Verbundlauf selbst an
# und legt das erhaltene Geheimnis in ihrer eigenen Datenbank ab. Sie beginnt
# auf der Lesestufe; den Handel schaltet der Betreiber des Verbunds frei.
HUB_JOIN_SECRET=
# Nur nötig, um *weitere* Instanzen anzumelden. Trägt `hub:setup` selbst ein.
HUB_ADMIN_SECRET=
